@model AwesomeNetwork.ViewModels.Account.UserEditViewModel
@using Microsoft.AspNetCore.Identity;
@using AwesomeNetwork.Models.Users;
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@if (!SignInManager.IsSignedIn(User))
{
    <div class="alert alert-danger">Вы должны быть авторизованы.</div>
    return;
}

<div class="container mt-5">
    <h1>Редактирование профиля</h1>

    <!-- Форма с POST-запросом -->
    <form method="post" asp-controller="Account" asp-action="Edit">
        @Html.AntiForgeryToken() <!-- Защита от подделки запросов -->
        @* Скрытое поле идентификатора, чтобы контроллер знал, кого редактировать *@
        <input type="hidden" asp-for="@Model.UserId" />

        <div class="row g-3">
            <!-- Левая колонка (имя, фамилия) -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="@Model.FirstName"></label>
                    <input class="form-control" asp-for="@Model.FirstName" />
                    <span class="text-danger" asp-validation-for="@Model.FirstName"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.LastName"></label>
                    <input class="form-control" asp-for="@Model.LastName" />
                    <span class="text-danger" asp-validation-for="@Model.LastName"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.MiddleName"></label>
                    <input class="form-control" asp-for="@Model.MiddleName" />
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.BirthDate"></label>
                    <input class="form-control" asp-for="@Model.BirthDate" type="date" />
                    <span class="text-danger" asp-validation-for="@Model.BirthDate"></span>
                </div>
            </div>

            <!-- Правая колонка (email, аватарка, о себе) -->
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="@Model.Email"></label>
                    <input class="form-control" asp-for="@Model.Email" />
                    <span class="text-danger" asp-validation-for="@Model.Email"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.Image"></label>
                    <input class="form-control" asp-for="@Model.Image" />
                    <span class="text-danger" asp-validation-for="@Model.Image"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="@Model.About"></label>
                    <textarea rows="3" class="form-control" asp-for="@Model.About"></textarea>
                </div>
            </div>
        </div>

        <!-- Большая зелёная кнопка внизу -->
        <button type="submit" class="btn btn-success w-100 py-3 fw-bold">Сохранить</button>
    </form>
</div>