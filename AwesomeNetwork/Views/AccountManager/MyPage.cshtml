@model AwesomeNetwork.ViewModels.Account.UserViewModel
@using Microsoft.AspNetCore.Identity;
@using AwesomeNetwork.Models.Users;
@inject SignInManager<User> SignInManager

@if (!SignInManager.IsSignedIn(User))
{
    <div class="alert alert-danger">Вы должны быть авторизованы.</div>
}
else
{
	<!-- Теперь весь контент находится в сетке -->
	<h1>@Model.User.GetFullName()</h1>

	<div class="grid-container">
		<div>
			<!-- Левая часть (аватар) -->
			<div>
				<div><img class="profile-img" alt="Аватар" src="https://thispersondoesnotexist.com" id="01a1a321-b204-7040-b03c-a8f227d73d46" /></div>
			</div>

			<div>
				<form method="get" asp-controller="AccountManager" asp-action="EditUserProfile">
					<!-- Скрытое поле для защиты от подделки запросов -->
					@* @Html.AntiForgeryToken() *@
					<input class="button-profile" type="submit" value="Редактировать" />
@* 					<button type="submit"
							class="button-profile">
						Редактировать
					</button> *@
				</form>
			</div>
		</div>
		<div>
			<!-- Правая часть (информация о пользователе) -->
			<div class="about">
				<p><strong>Статус:</strong> @Model.User.Status</p>
				<span><strong>Дата рождения:</strong> @Model.User.BirthDate.ToString("dd MMMM yyyy г.")</span>
				<br /><span><strong>О себе:</strong> @Model.User.About</span>
				<br /><span><strong>Email:</strong> @Model.User.Email</span>
			</div>
			<div class="lined-block">
				<label class="gray-text">Список друзей</label>

				@if (Model.Friends.Count != 0)
				{

					@foreach (var user in @Model.Friends)
					{
						<div>
							<label>@user.GetFullName()</label>
							<form asp-controller="AccountManager" asp-action="DeleteFriend" asp-route-id="@user.Id" method="post">
								<button type="submit" class="btn btn-sm btn-primary">
									Удалить из друзей
								</button>
							</form>
						</div>
					}
				}
				else
				{
					<div>
						<label> У вас пока нет друзей.</label>
					</div>
				}

			</div>
		</div>
	</div>
}