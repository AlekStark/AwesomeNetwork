@model AwesomeNetwork.ViewModels.Account.SearchViewModel;

<div class="block-reg background-white">

    @* Проверка на null или пустоту *@
    @if (Model.Users?.Any() == true) // Более современный синтаксис
    {
        @foreach (var user in Model.Users)
        {
            <div>
                <!-- Убедитесь, что метод GetFullName есть у UserWithFriendExt -->
                <label>@user.GetFullName()</label>
            </div>
        }
    }
    else
    {
        <label> Поиск не дал результатов.</label>
    }

</div>