@using Microsoft.AspNetCore.Identity;
@using AwesomeNetwork.Models.Users;
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <a asp-area="" asp-controller="AccountManager" asp-action="Logout">Выход</a>
}
else
{
    <div class="row">
        <div class="side">
            <div class="center">
                Пользуйтесь нашей самой крутой соцсетью! Регистрируйтесь всего за 2 минуты, делитесь мыслями, находите новых друзей.
            </div>
            <img class="main-img" src="https://pngimg.com/uploads/fox/fox_PNG23172.png" />
        </div>


        <div class="main">
            <partial name="Login"
                     @* model="Model.LoginView" *@ />
            <partial name="Register"
                     @* model="Model.RegisterView" *@ />
        </div>

    </div>
}