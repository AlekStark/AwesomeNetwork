@using Microsoft.AspNetCore.Identity
@using AwesomeNetwork.Models.Users
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AwesomeNetwork</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/main-page.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/base-styles.css" />
    <link rel="stylesheet" href="~/css/profile.css">
    <link rel="stylesheet" href="~/css/search-results.css">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body class="background-main">
    @inject SignInManager<User> SignInManager

    <header class="border-bottom header background-white">
        <div class="container">
            <div class="topnav">
                <!-- Условный логотип -->
                @if (SignInManager.IsSignedIn(User))
                {
                    <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="AccountManager" asp-action="MyPage">
                        <img src="~/images/logo.png" class="me-2" alt="SocialNetwork" width="40" height="40" />
                        <span class="d-none d-sm-inline-block">SocialNetwork</span>
                    </a>
                }
                else
                {
                    <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo.png" class="me-2" alt="SocialNetwork" width="40" height="40" />
                        <span class="d-none d-sm-inline-block">SocialNetwork</span>
                    </a>
                }

                <partial name="_SearchLayoutPartial" />
                <partial name="_LogoutPartial" />
            </div>
        </div>
    </header>
    <div class="container background-main">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2021 - AwesomeNetwork - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
