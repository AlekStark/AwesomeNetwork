@using Microsoft.AspNetCore.Identity;
@using AwesomeNetwork.Models.Users;
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@if (SignInManager.IsSignedIn(User))
{
      @*Пример из курсов, он ошибочен
        <a class="exit_submit" asp-area="" asp-controller="AccountManager" asp-action="Logout">Выход</a>*@
          
        <!-- ВНИМАНИЕ: Метод должен быть POST! --> 
        <form method="post" asp-controller="AccountManager" asp-action="Logout"> 
        <button type="submit" class="exit_submit">Выход</button> 
        </form>
}
